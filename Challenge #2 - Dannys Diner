--Q8 What is the total items and amount spent for each member before they became a member?
select * from sales;
select * from menu;
select * from members;

WITH CTE AS (
SELECT
s.customer_id
, s.order_date
--, s.product_id
, m.product_name
, m.price
, mbr.join_date
, CASE WHEN s.order_date >= mbr.join_date THEN 'On_or_After_JD'
	WHEN s.order_date < mbr.join_date THEN 'Before_JD'
	END AS When_Purchased
FROM
sales AS s LEFT JOIN menu AS m ON s.product_id = m.product_id
LEFT JOIN members AS mbr ON s.customer_id = mbr.customer_id
)
SELECT
customer_id
, count(distinct product_name) as num_items_bought
, SUM(price) as total_spent
FROM CTE
WHERE When_Purchased = 'Before_JD'
GROUP BY customer_id;
--A should be $25 with 2 distinct items, B should be $40 with 2 distinct items
/*
customer_id	num_items_bought	total_spent
A	2	25
B	2	40
*/

--Q9 If each $1 spent equates to 10 points and sushi has a 2x points multiplier - how many points would each customer have?
select * from sales;
select * from menu;
select * from members;

WITH CTE AS (
	SELECT
	S.CUSTOMER_ID
	, S.ORDER_DATE
	--, S.PRODUCT_ID
	, M.PRODUCT_NAME
	, M.PRICE
	, SUM(CASE WHEN PRODUCT_NAME = 'sushi' THEN PRICE*10*2 ELSE PRICE*10 END) AS POINTS
	FROM SALES S LEFT JOIN MENU M ON S.PRODUCT_ID = M.PRODUCT_ID
	GROUP BY
	S.CUSTOMER_ID
	, S.ORDER_DATE
	--, S.PRODUCT_ID
	, M.PRODUCT_NAME
	, M.PRICE
)
SELECT 
CUSTOMER_ID
, SUM(POINTS) AS TOTAL_POINTS_PER_CUST
FROM CTE
GROUP BY CUSTOMER_ID;
/*
CUSTOMER_ID	TOTAL_POINTS_PER_CUST
A	860
B	940
C	360
*/



--Q10 In the first week after a customer joins the program (including their join date) they earn 2x points on all items, not just sushi - how many points do customer A and B have at the end of January?
select * from sales;
select * from menu;
select * from members;

--------------------------------------------------------------------------------

WITH CTE AS (
	SELECT
	S.CUSTOMER_ID
	, S.ORDER_DATE
	, MBR.JOIN_DATE
	, M.PRODUCT_NAME
	, M.PRICE
	--FROM QUESTION #9:, SUM(CASE WHEN PRODUCT_NAME = 'sushi' THEN PRICE*10*2 ELSE PRICE*10 END) AS POINTS
	, CASE WHEN ORDER_DATE>= JOIN_DATE THEN 'MEMBER' ELSE 'NOT_YET_MEMBER' END AS MEMBER_OR_NOT
	FROM SALES S LEFT JOIN MENU M ON S.PRODUCT_ID = M.PRODUCT_ID
	LEFT JOIN MEMBERS MBR ON S.CUSTOMER_ID = MBR.CUSTOMER_ID
	GROUP BY
	S.CUSTOMER_ID
	, S.ORDER_DATE
	, M.PRODUCT_NAME
	, M.PRICE
	, MBR.JOIN_DATE
	--ORDER BY 
	--CUSTOMER_ID
	--, ORDER_DATE ASC
)
SELECT
*
, DATEDIFF(DAY,JOIN_DATE,ORDER_DATE) AS DAYS_AS_A_MEMBER
, CASE WHEN DATEDIFF(DAY,JOIN_DATE,ORDER_DATE) <= 7 THEN 'FIRST_WEEK_PTS' ELSE 'REGULAR_PTS' END AS TYPE_OF_PTS
, CASE WHEN DATEDIFF(DAY,JOIN_DATE,ORDER_DATE) <= 7 THEN SUM(PRICE*10*2) /*DOUBLE POINTS DURING 1ST WK AS MEMBER*/ ELSE SUM(PRICE*10) /*REGULAR POINTS*/ END AS POINTS
FROM CTE 
WHERE MEMBER_OR_NOT = 'MEMBER' --KEEP THE MEMBERS, DROP THE REST
AND DATETRUNC(MONTH, ORDER_DATE) = '2021-01-01' --DROP ANYTHING NOT PURCHASED IN JANUARY
GROUP BY
CUSTOMER_ID
, ORDER_DATE
, PRODUCT_NAME
, PRICE
, JOIN_DATE
, MEMBER_OR_NOT
ORDER BY 
CUSTOMER_ID
, ORDER_DATE ASC;

/*
