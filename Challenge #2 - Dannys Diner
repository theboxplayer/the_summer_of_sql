A	2021-01-11	2021-01-07	ramen	12	MEMBER	4	FIRST_WEEK_PTS	240
B	2021-01-11	2021-01-09	sushi	10	MEMBER	2	FIRST_WEEK_PTS	200
B	2021-01-16	2021-01-09	ramen	12	MEMBER	7	FIRST_WEEK_PTS	240
*/

/*GOT BOXED IN BY THE ABOVE, SO RE-WORKED IT BELOW*/

------------------------------------------------------------------------------------------------

WITH BIG_CTE AS (
SELECT
*
, DATEDIFF(DAY,JOIN_DATE,ORDER_DATE) AS DAYS_AS_A_MEMBER
, CASE WHEN DATEDIFF(DAY,JOIN_DATE,ORDER_DATE) <= 7 THEN 'FIRST_WEEK_PTS' ELSE 'REGULAR_PTS' END AS TYPE_OF_PTS
, CASE WHEN DATEDIFF(DAY,JOIN_DATE,ORDER_DATE) <= 7 THEN SUM(PRICE*10*2) /*DOUBLE POINTS DURING 1ST WK AS MEMBER*/ ELSE SUM(PRICE*10) /*REGULAR POINTS*/ END AS POINTS
FROM 
(
	SELECT
	S.CUSTOMER_ID
	, S.ORDER_DATE
	, MBR.JOIN_DATE
	, M.PRODUCT_NAME
	, M.PRICE
	, CASE WHEN ORDER_DATE>= JOIN_DATE THEN 'MEMBER' ELSE 'NOT_YET_MEMBER' END AS MEMBER_OR_NOT
	FROM SALES S LEFT JOIN MENU M ON S.PRODUCT_ID = M.PRODUCT_ID
	LEFT JOIN MEMBERS MBR ON S.CUSTOMER_ID = MBR.CUSTOMER_ID
	GROUP BY
	S.CUSTOMER_ID
	, S.ORDER_DATE
	, M.PRODUCT_NAME
	, M.PRICE
	, MBR.JOIN_DATE
) AS X
WHERE MEMBER_OR_NOT = 'MEMBER' --KEEP THE MEMBERS, DROP THE REST
AND DATETRUNC(MONTH, ORDER_DATE) = '2021-01-01' --DROP ANYTHING NOT PURCHASED IN JANUARY
GROUP BY
CUSTOMER_ID
, ORDER_DATE
, PRODUCT_NAME
, PRICE
, JOIN_DATE
, MEMBER_OR_NOT
--ORDER BY 
--CUSTOMER_ID
--, ORDER_DATE ASC
/*
AT THIS POINT IT'S THE VERY SAME AS THE FIRST ATTEMPT, BUT NEED TO SUMMARIZE PER CUSTOMER
CUSTOMER_ID	ORDER_DATE	JOIN_DATE	PRODUCT_NAME	PRICE	MEMBER_OR_NOT	DAYS_AS_A_MEMBER	TYPE_OF_PTS	POINTS
A	2021-01-07	2021-01-07	curry	15	MEMBER	0	FIRST_WEEK_PTS	300
A	2021-01-10	2021-01-07	ramen	12	MEMBER	3	FIRST_WEEK_PTS	240
A	2021-01-11	2021-01-07	ramen	12	MEMBER	4	FIRST_WEEK_PTS	240
B	2021-01-11	2021-01-09	sushi	10	MEMBER	2	FIRST_WEEK_PTS	200
B	2021-01-16	2021-01-09	ramen	12	MEMBER	7	FIRST_WEEK_PTS	240
*/
)
SELECT
CUSTOMER_ID
, SUM(POINTS) AS CUST_TOTAL_PTS
FROM BIG_CTE
GROUP BY
CUSTOMER_ID;

